{
  "manifest_version": 2,
  "name": "Share with ChatGPT",
  "version": "0.1.0",
  "description": "Open a new ChatGPT tab with the current page's rendered text supplied as context.",
  "icons": {
    "48": "icons/chatgpt.svg",
    "96": "icons/chatgpt.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "share-with-chatgpt@local",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {}
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "https://chatgpt.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Share with ChatGPT",
    "default_icon": {
      "48": "icons/chatgpt.svg",
      "96": "icons/chatgpt.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt-handoff.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
